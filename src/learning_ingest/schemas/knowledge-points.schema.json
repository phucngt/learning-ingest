{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-ingest/knowledge-points.schema.json",
  "title": "Gói import điểm kiến thức (chờ rà soát)",
  "description": "knowledge-points.json do validate-export xuất cho app ôn thi. Mọi điểm ở trạng thái pending_review cho tới khi HCNS duyệt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package", "knowledge_points"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "course_id", "session_id", "session_label", "review_status", "generator", "extract_id", "package_ids", "input_sha256"],
      "properties": {
        "subject_id": { "type": "string" },
        "subject_name": { "type": ["string", "null"] },
        "programs": { "type": "array", "items": { "type": "string" } },
        "subject_order": { "type": "integer", "minimum": 1 },
        "subject_id_status": { "enum": ["proposed", "confirmed"] },
        "course_id": { "type": "string" },
        "course_name": { "type": ["string", "null"] },
        "session_id": { "type": "string" },
        "session_label": { "type": "string" },
        "review_status": { "const": "pending_review" },
        "generator": { "type": "string" },
        "extract_id": { "type": "string" },
        "package_ids": { "type": "array", "items": { "type": "string" } },
        "input_sha256": { "type": "array", "items": { "type": "string" } }
      }
    },
    "knowledge_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_point_id", "title", "summary", "subject_id", "chapter_id", "chapter_id_reason",
          "session_id", "existing_knowledge_point_id", "existing_match_reason", "sources",
          "verification_flags", "conflicts", "review_status", "review_notes", "ai_local_ids"
        ],
        "properties": {
          "knowledge_point_id": { "type": "string", "pattern": "^kp-[0-9a-f]{12}$" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "subject_id": { "type": "string" },
          "chapter_id": { "type": ["string", "null"] },
          "chapter_id_reason": { "type": ["string", "null"] },
          "session_id": { "type": "string" },
          "existing_knowledge_point_id": { "type": ["string", "null"] },
          "existing_match_reason": { "type": ["string", "null"] },
          "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
          "verification_flags": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "text", "note", "sources"],
              "properties": {
                "kind": { "enum": ["number", "deadline", "legal_reference", "other"] },
                "text": { "type": "string" },
                "note": { "type": ["string", "null"] },
                "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
              }
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["topic", "claims", "note"],
              "properties": {
                "topic": { "type": "string" },
                "note": { "type": ["string", "null"] },
                "claims": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["source", "statement"],
                    "properties": {
                      "source": { "$ref": "#/$defs/source" },
                      "statement": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "review_status": { "const": "pending_review" },
          "review_notes": { "type": "string" },
          "ai_local_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source_id", "title", "label", "url", "link_kind"],
      "properties": {
        "type": { "enum": ["video", "slide", "syllabus", "document"] },
        "source_id": { "type": "string" },
        "title": { "type": "string" },
        "label": { "type": "string", "description": "Dòng hiển thị, ví dụ 'Ngày 2 · 00:12:03', 'Ngày 2_1 · trang 5', 'Bài trình bày · slide 3' hoặc 'Quy chế · mục Điều 1'." },
        "url": { "type": ["string", "null"] },
        "link_kind": {
          "enum": ["timestamp", "page", "file", "none"],
          "description": "timestamp/page: link nhảy đúng chỗ; file: link tới file, mốc/trang ghi dạng chữ; none: chưa có link."
        },
        "segment_id": { "type": "string" },
        "start_ms": { "type": "integer" },
        "end_ms": { "type": "integer" },
        "timestamp": { "type": "string" },
        "excerpt": { "type": "string" },
        "pdf_page": { "type": "integer" },
        "section_id": { "type": ["string", "null"] },
        "heading": { "type": "string", "description": "Tiêu đề mục của văn bản .docx (chỉ type = document)." },
        "needs_ocr": { "type": "boolean" },
        "quote": { "type": ["string", "null"] }
      }
    }
  }
}
